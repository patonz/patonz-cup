---
import Sticker from './Sticker.astro';
import { isCaptain, type Team } from '../lib/editions';

interface Props {
  team: Team;
  champion?: boolean;
}

const EMPTY_SLOTS = 5;

const { team, champion = false } = Astro.props;
const players = [...team.players].sort((a, b) => Number(isCaptain(b)) - Number(isCaptain(a)));
const slots: (string | null)[] = players.length ? players : Array(EMPTY_SLOTS).fill(null);
---

<div class="mt-6">
  <h3 class="flex items-center gap-2 font-display text-xl uppercase">
    <span
      class="h-5 w-5 shrink-0 rounded-full border-[3px] border-ink"
      style={`background: ${team.colors[0].toLowerCase() === '#ffffff' ? team.colors[1] : team.colors[0]}`}
    ></span>
    {team.name}
    {champion && <span aria-label="Champions">🏆</span>}
  </h3>
  <ul class="mt-3 grid grid-cols-3 gap-3 sm:grid-cols-5">
    {
      slots.map((name, i) => (
        <li>
          <Sticker name={name} number={i + 1} color={team.colors[0]} mark={team.colors[1]} champion={champion} />
        </li>
      ))
    }
  </ul>
  {!team.players.length && <p class="mt-2 text-base text-ink/60">Stickers still to be stuck in…</p>}
</div>
