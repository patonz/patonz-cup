---
import '../styles/global.css';
import Album from '../components/Album.astro';
import Cover from '../components/Cover.astro';
import Footer from '../components/Footer.astro';
import HallOfFame from '../components/HallOfFame.astro';
import Lightbox from '../components/Lightbox.astro';
import { formatDate, ordinal, upcoming } from '../lib/editions';

const base = import.meta.env.BASE_URL;
const siteUrl = new URL(base, Astro.site).href;
const ogImage = new URL(`${base}og.png`, Astro.site).href;
const description = upcoming?.date
  ? `${ordinal(upcoming.edition)} edition: ${formatDate(upcoming.date)}. The annual match between friends: teams, jerseys and hall of fame.`
  : 'The annual match between friends: teams, jerseys and hall of fame.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Patonz Cup</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#d62828" />
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content="Patonz Cup" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Barlow+Condensed:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-screen">
    <main class="mx-auto max-w-3xl overflow-x-clip px-4 sm:px-6">
      <Cover shareUrl={siteUrl} />
      <HallOfFame />
      <Album />
      <Footer />
    </main>
    <Lightbox />
  </body>
</html>
